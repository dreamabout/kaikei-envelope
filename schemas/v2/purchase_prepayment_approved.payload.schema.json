{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/dreamabout/kaikei-envelope/schemas/v2/purchase_prepayment_approved.payload.schema.json",
    "title": "purchase.prepayment_approved payload",
    "description": "Profile P: an approved supplier prepayment (proforma), Dreamshop -> kaikei. Paid at once, so it has no due date. The VAT is reposted on the payment date (purchase.prepayment_paid).",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "client_id",
        "obligation_id",
        "document",
        "vat_treatment",
        "supplier",
        "lines",
        "approval",
        "document_file"
    ],
    "properties": {
        "client_id": {
            "type": "string",
            "minLength": 1,
            "description": "The kaikei client (one kaikei deployment = one client = one e-conomic agreement). Carried in data because the envelope has additionalProperties:false. The receiver rejects a foreign client with klient_forkert."
        },
        "obligation_id": {
            "type": "string",
            "minLength": 1,
            "description": "Dreamshop's id for the obligation. Together with the event type it is the idempotency key; a correction after a rejection is sent with the same obligation_id and a new event_id."
        },
        "document": {
            "$ref": "#/$defs/document"
        },
        "vat_treatment": {
            "type": "string",
            "enum": [
                "domestic",
                "eu_reverse_charge",
                "import",
                "none"
            ]
        },
        "supplier": {
            "$ref": "#/$defs/supplier"
        },
        "lines": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/line"
            },
            "minItems": 1
        },
        "fees": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/fee"
            }
        },
        "deviations": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/deviation"
            }
        },
        "approval": {
            "$ref": "#/$defs/approval"
        },
        "document_file": {
            "$ref": "#/$defs/document_file"
        }
    },
    "$defs": {
        "document": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "number",
                "date",
                "due_date",
                "currency",
                "amount_net",
                "vat_amount",
                "vat_free_amount",
                "amount_gross"
            ],
            "description": "The document's own totals, as printed on it. amount_net + vat_free_amount + vat_amount == amount_gross is enforced by the validator (tier 3). All amounts are positive magnitudes, credit notes included: the event type says it is a credit.",
            "properties": {
                "number": {
                    "type": "string",
                    "minLength": 1
                },
                "date": {
                    "type": "string",
                    "format": "date"
                },
                "due_date": {
                    "type": "null",
                    "description": "Always null: a prepayment is paid at once."
                },
                "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                },
                "amount_net": {
                    "type": "string",
                    "pattern": "^-?\\d+\\.\\d{2}$",
                    "description": "The VAT-able base (momspligtigt beloeb)."
                },
                "vat_amount": {
                    "type": "string",
                    "pattern": "^-?\\d+\\.\\d{2}$",
                    "description": "The VAT on the document, as printed. kaikei does not compute VAT."
                },
                "vat_free_amount": {
                    "type": "string",
                    "pattern": "^-?\\d+\\.\\d{2}$",
                    "description": "The VAT-free part of the document (momsfrit beloeb). 0.00 when there is none."
                },
                "amount_gross": {
                    "type": "string",
                    "pattern": "^-?\\d+\\.\\d{2}$",
                    "description": "The document total including VAT."
                },
                "payment_reference": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "supplier": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "supplier_id",
                "name",
                "vat_number",
                "country"
            ],
            "properties": {
                "supplier_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The supplier's id in Dreamshop."
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "vat_number": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1,
                    "description": "As written on the supplier in Dreamshop; compared normalised (VatNumber::normalize). null only for a supplier outside the EU (validator, tier 3)."
                },
                "country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$",
                    "description": "ISO 3166-1 alpha-2 (GR for Greece, not the VAT prefix EL)."
                },
                "economic_supplier_number": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The e-conomic supplier number set on the supplier in Dreamshop, if anyone has set it. First in kaikei's lookup order; see docs/events/purchase.md."
                }
            }
        },
        "line": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "description",
                "quantity",
                "unit_price",
                "amount"
            ],
            "properties": {
                "description": {
                    "type": "string",
                    "minLength": 1
                },
                "quantity": {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d{1,3})?$",
                    "description": "Decimal string, up to 3 places. A positive magnitude on every event type, credit notes included."
                },
                "unit_price": {
                    "type": "string",
                    "pattern": "^-?\\d+\\.\\d{2,4}$",
                    "description": "Price per unit after any line discount, excluding VAT. 2-4 decimal places."
                },
                "amount": {
                    "type": "string",
                    "pattern": "^-?\\d+\\.\\d{2}$",
                    "description": "The line total excluding VAT, as printed."
                },
                "item_number": {
                    "type": "string",
                    "minLength": 1
                },
                "ean": {
                    "type": "string",
                    "pattern": "^\\d{8,14}$"
                },
                "purchase_order_id": {
                    "type": "string",
                    "minLength": 1
                },
                "purchase_order_line_id": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "fee": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "label",
                "amount"
            ],
            "properties": {
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "amount": {
                    "type": "string",
                    "pattern": "^-?\\d+\\.\\d{2}$",
                    "description": "Excluding VAT."
                }
            }
        },
        "deviation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "field",
                "expected",
                "found",
                "amount"
            ],
            "description": "A difference the approver accepted between the document and what Dreamshop expected (purchase order, receipt).",
            "properties": {
                "line": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Zero-based index into lines[]. Absent for a deviation on the document as a whole."
                },
                "field": {
                    "type": "string",
                    "minLength": 1
                },
                "expected": {
                    "type": "string"
                },
                "found": {
                    "type": "string"
                },
                "amount": {
                    "type": "string",
                    "pattern": "^-?\\d+\\.\\d{2}$",
                    "description": "The deviation's effect on the document total, excluding VAT. Negative when the document is lower than expected."
                }
            }
        },
        "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "approved_by",
                "approved_at"
            ],
            "properties": {
                "approved_by": {
                    "type": "string",
                    "format": "email",
                    "description": "The approver's Google Workspace e-mail, so segregation of duties (R5) can be enforced across systems."
                },
                "approved_at": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "document_file": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "url",
                "sha256",
                "mimetype",
                "filename",
                "size_bytes"
            ],
            "description": "Where the receiver fetches the document. The URL is a Dreamshop endpoint that only answers a request signed with the envelope's HMAC scheme; it answers with a short-lived presigned URL (302) or the file itself. The receiver checks sha256 before uploading.",
            "properties": {
                "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "mimetype": {
                    "type": "string",
                    "pattern": "^[a-z]+/[a-z0-9.+-]+$"
                },
                "filename": {
                    "type": "string",
                    "minLength": 1
                },
                "size_bytes": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        }
    }
}
