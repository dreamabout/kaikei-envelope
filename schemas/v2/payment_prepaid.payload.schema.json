{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dreamabout/kaikei-envelope/schemas/v2/payment_prepaid.payload.schema.json",
  "title": "payment.prepaid payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "customer",
    "gateway",
    "transaction_id",
    "prepaid_at",
    "items"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "customer": {
      "$ref": "#/$defs/customer"
    },
    "gateway": {
      "type": "string",
      "minLength": 1
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "prepaid_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "fx_rate": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$"
    },
    "amount": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2}$",
      "description": "What the payment provider actually took, in the order's currency (`currency`). Optional (since 1.19.0). Can exceed the sum of `items` when the customer overpaid; the receiver books the excess as a balance owed to the customer. Absent: the receiver takes the sum of `items`, as before 1.19.0. Unlike `settlement_amount`, which is in the settlement currency and so cannot be compared with the lines."
    },
    "invoice_number": {
      "type": "string",
      "minLength": 1
    },
    "settlement_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "settlement_amount": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$"
    },
    "settlement_fx_rate": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2,14}$"
    }
  },
  "$defs": {
    "customer": {
      "type": "object",
      "required": [
        "country_code",
        "is_b2b"
      ],
      "properties": {
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "postal_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 -]{0,11}$",
          "description": "DELIVERY postal code, from the same address as country_code. Determines the VAT territory: 78266 is Buesingen (outside the EU VAT area entirely), 6691 is Jungholz (19%, not Austria's 20%). A billing postal code paired with a delivery country is wrong in exactly the cases this exists to catch."
        },
        "is_b2b": {
          "type": "boolean"
        },
        "customer_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "vat_number": {
          "type": "string"
        },
        "ean_number": {
          "type": "string",
          "pattern": "^[0-9]{13}$"
        },
        "address": {
          "type": "object",
          "properties": {
            "street": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "postal_code": {
              "type": "string"
            },
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "type",
        "gross_amount",
        "vat_amount",
        "vat_rate"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "physical",
            "gift_card",
            "digital",
            "shipping",
            "fee",
            "giftwrapping",
            "discount"
          ]
        },
        "gross_amount": {
          "type": "string",
          "pattern": "^-?\\d+\\.\\d{2}$"
        },
        "vat_amount": {
          "type": "string",
          "pattern": "^-?\\d+\\.\\d{2}$"
        },
        "vat_rate": {
          "type": "string",
          "pattern": "^-?\\d+\\.\\d{2,4}$"
        }
      }
    }
  }
}
