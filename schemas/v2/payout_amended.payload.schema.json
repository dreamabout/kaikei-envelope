{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/dreamabout/kaikei-envelope/schemas/v2/payout_amended.payload.schema.json",
    "title": "payout.amended payload",
    "description": "A payout already reported by payout.paid gained transactions. Same fields as payout.paid; transaction_ids is the payout's FULL new list and fee_amount its full new fee, not a delta.",
    "type": "object",
    "additionalProperties": false,
    "required": ["payout_id", "gateway", "transaction_ids", "gross_amount", "fee_amount", "net_amount", "paid_at"],
    "properties": {
        "payout_id": { "type": "string", "minLength": 1 },
        "gateway": { "type": "string", "minLength": 1 },
        "transaction_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
        },
        "gross_amount": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
        "fee_amount": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
        "net_amount": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
        "payout_fee_amount": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
        "paid_at": { "type": "string", "format": "date-time" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "fx_rate": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
        "presentment_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "presentment_amount": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
        "presentment_fx_rate": { "type": "string", "pattern": "^\\d+\\.\\d{2,8}$" }
    }
}
